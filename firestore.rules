rules_version = '2';

// Only signed-in staff accounts (created by an admin in the Firebase
// console: Authentication -> Users -> Add user) may read or write donor
// data. There is no public/anonymous access — the app is an internal tool.
service cloud.firestore {
  match /databases/{database}/documents {

    match /donors/{donorId} {
      allow read, write: if request.auth != null;
    }

    match /meta/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
