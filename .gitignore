# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
pubspec.lock

# android/ and web/ ARE committed — they hold the app name ("Thway"), the
# launcher icon / favicon, the browser <title>, the INTERNET permission and
# the url_launcher <queries>. Regenerating them with `flutter create` would
# wipe those, so CI/Vercel must NOT run `flutter create` for these platforms.
# The unused desktop / iOS folders stay generated-on-demand.
/ios/
/linux/
/macos/
/windows/

# Android build noise (the rest of android/ is tracked)
/android/.gradle/
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/local.properties
/android/key.properties
/android/**/GeneratedPluginRegistrant.java
/android/.kotlin/

# Note: lib/firebase_options.dart is intentionally NOT ignored. Firebase's
# web/Android client config values are not secret (Google's own guidance) —
# real protection comes from Firestore Security Rules (see firestore.rules)
# and, optionally, restricting the API key to your domains in Google Cloud
# Console. Committing it is what lets GitHub Actions / Vercel build the app
# without any extra secret setup.

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
